{
    "homepage": "https://volta.sh/",
    "description": "Volta is a hassle-free way to manage your JavaScript command-line tools (maintained fork)",
    "license": "BSD-2-Clause",
    "version": "2.1.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/chawyehsu/volta/releases/download/v2.1.0/volta-x86_64-pc-windows-msvc.zip",
            "hash": "4b28932068fe9721a65dc4a8dc80f44825ee3fd34780ddca6a2752af9251a392"
        },
        "arm64": {
            "url": "https://github.com/chawyehsu/volta/releases/download/v2.1.0/volta-aarch64-pc-windows-msvc.zip",
            "hash": "a5a04087824864f2470b2c11395facef27484312ad0883d0cd92d00257949264"
        }
    },
    "installer": {
        "script": [
            "# remove old shim wrappers as they are now unnecessary",
            "@('node', 'npm', 'npx', 'pnpm', 'yarn', 'yarnpkg') | ForEach-Object {",
            "    if (Test-Path \"$persist_dir\\appdata\\bin\\$_\") {",
            "        Remove-Item \"$persist_dir\\appdata\\bin\\$_\" -Force -ErrorAction SilentlyContinue",
            "    }",
            "    if (Test-Path \"$persist_dir\\appdata\\bin\\$_.cmd\") {",
            "        Remove-Item \"$persist_dir\\appdata\\bin\\$_.cmd\" -Force -ErrorAction SilentlyContinue",
            "    }",
            "}",
            "# remove old volta exes as now they are located in the install root",
            "@('volta', 'volta-migrate', 'volta-shim') | ForEach-Object {",
            "    if (Test-Path \"$persist_dir\\appdata\\bin\\$_.exe\") {",
            "        Remove-Item \"$persist_dir\\appdata\\bin\\$_.exe\" -Force -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "bin": [
        "volta.exe",
        "volta-migrate.exe"
    ],
    "env_set": {
        "VOLTA_HOME": "$dir\\appdata"
    },
    "env_add_path": "appdata\\bin",
    "persist": "appdata",
    "checkver": {
        "github": "https://github.com/chawyehsu/volta"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chawyehsu/volta/releases/download/v$version/volta-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/chawyehsu/volta/releases/download/v$version/volta-aarch64-pc-windows-msvc.zip"
            }
        }
    },
    "notes": [
        "To use volta tab-completions, add following code to your PowerShell PROFILE:",
        "",
        "(& volta completions powershell) | Out-String | Invoke-Expression"
    ]
}
