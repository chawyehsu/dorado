{
    "version": "3.4.3.2",
    "description": "Screenshots, screen recording, OCR tool.",
    "homepage": "https://pixpin.cn/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://pixpin.cn/docs/policy/tos_zh_CN"
    },
    "architecture": {
        "64bit": {
            "url": "https://down.pixpin.cn/PixPin_win_3.4.3.2.zip#/dl.zip",
            "hash": "1ed2b048f7e1468cdd3dc869c3db0653d9308ffe4f48fb42091b0b559a90b211"
        }
    },
    "extract_dir": "PixPin",
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "persist": [
        "Config",
        "Data",
        "History",
        "OcrModel"
    ],
    "post_install": [
        "$configPath = \"$persist_dir\\Config\\PixPinConfig.json\"",
        "if (Test-Path $configPath) {",
        "    return",
        "}",
        "$timestamp = [DateTimeOffset]::Now.ToUnixTimeSeconds()",
        "$content = '{\"System.Update.UpgradeMode#s.win\":{\"t\":' + $timestamp + ',\"v\":0}}'",
        "$content | Set-Content -Path $configPath -Encoding UTF8"
    ],
    "checkver": {
        "url": "https://pixpin.cn/download/",
        "regex": "PixPin_win_(\\d+(?:\\.\\d+)*)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://down.pixpin.cn/PixPin_win_$version.zip#/dl.zip"
            }
        }
    }
}
