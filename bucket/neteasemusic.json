            "hash": "b2d80aefaa2869e26986c6446d05119448fa30b2df2b72dd70c96924af2922b7"
        },
        "32bit": {
            "url": "https://d8.music.126.net/dmusic2/NeteaseCloudMusic_Music_official_3.1.40.205461_32.exe#/dl.7z",
            "hash": "eeec4f61eb872373df37ab9c558d41ba7f9052333dad49b5f29561c7403416b0"
        }
    },
    "installer": {
        "script": [
            "Get-ChildItem \"$dir\\redist_packages\" | Move-Item -Destination \"$dir\" -Force",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name $bucket) scripts/DoradoUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\Netease\\CloudMusic\"",
            "Remove-Module -Name DoradoUtils"
        ]
    },
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\",\"$dir\\redist_packages\" -Force -Recurse",
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name $bucket) scripts/DoradoUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Netease\\CloudMusic\"",
            "Remove-Module -Name DoradoUtils"
        ]
    },
    "bin": "cloudmusic.exe",
    "shortcuts": [
        [
            "cloudmusic.exe",
            "网易云音乐"
        ]
    ],
    "checkver": {
        "url": "https://music.163.com/api/appcustomconfig/get",
        "script": [
            "# The checkver url is treated as a placeholder because the homepage url returns an incorrect charset name 'utf8' (it should be 'utf-8'), which causes error in checkver progress.",
            "return $(Invoke-WebRequest -Uri 'https://music.163.com/download/pc/latest' -Method Head -UseBasicParsing | Select-Object -ExpandProperty RawContent)"
        ],
        "regex": "NeteaseCloudMusic_Music_official_([\\d.]+)_[\\d]+.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://d8.music.126.net/dmusic2/NeteaseCloudMusic_Music_official_$version_64.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://d8.music.126.net/dmusic2/NeteaseCloudMusic_Music_official_$version_32.exe#/dl.7z"
            }
        }
    }
}
