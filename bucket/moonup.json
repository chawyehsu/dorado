    "description": "Manage multiple MoonBit installations",
    "homepage": "https://github.com/chawyehsu/moonup",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/chawyehsu/moonup/releases/download/v0.6.1/moonup-x86_64-pc-windows-msvc.zip",
            "hash": "f45cb96b0a997cc713fa703e3d952182dd315c85b5e1ff2e7d1c7e8a7abf60cd"
        }
    },
    "bin": "moonup.exe",
    "checkver": {
