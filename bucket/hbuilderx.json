{
    "version": "5.34.2026102909",
    "description": "Lightweight IDE for Vue and uni-app development",
    "homepage": "https://www.dcloud.io/hbuilderx.html",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.dcloud.io/license/hbuilder.html"
    },
    "notes": [
        "Settings are stored in '%APPDATA%\\HBuilder X'.",
        "Close HBuilderX before updating and use Scoop to update the editor."
    ],
    "architecture": {
        "64bit": {
            "url": "https://download1.dcloud.net.cn/download/HBuilderX.5.34.2026102909.zip",
            "hash": "5ddef1fe3d61f9f11bd8f390b633f204eec00bd2c04fff270cbba21727c6eff4"
        }
    },
    "extract_dir": "HBuilderX",
    "pre_install": [
        "# Stage on the persist volume before replacing any bundled plugin.",
        "$pluginsDir = Join-Path $persist_dir 'plugins'",
        "if (Test-Path -LiteralPath $pluginsDir -PathType Container -ErrorAction Stop) {",
        "    $transaction = Join-Path $pluginsDir ('.scoop-hbuilderx-' + [guid]::NewGuid().ToString('N'))",
        "    $staging = Join-Path $transaction 'new'",
        "    $backup = Join-Path $transaction 'old'",
        "    $changes = @()",
        "    $keepBackup = $false",
        "    try {",
        "        [IO.Directory]::CreateDirectory($staging) | Out-Null",
        "        [IO.Directory]::CreateDirectory($backup) | Out-Null",
        "        foreach ($plugin in Get-ChildItem -LiteralPath \"$dir\\plugins\" -Force -ErrorAction Stop) {",
        "            $change = [pscustomobject]@{",
        "                Target = Join-Path $pluginsDir $plugin.Name",
        "                Staged = Join-Path $staging $plugin.Name",
        "                Backup = Join-Path $backup $plugin.Name",
        "                InstallStarted = $false",
        "            }",
        "            # Windows PowerShell needs extended paths for deeply nested plugin files.",
        "            $copyPaths = @($plugin.FullName, $change.Staged)",
        "            if ($PSVersionTable.PSEdition -eq 'Desktop') {",
        "                $copyPaths = @($copyPaths | ForEach-Object {",
        "                    if ($_.StartsWith('\\\\?\\')) { $_ }",
        "                    elseif ($_.StartsWith('\\\\')) { '\\\\?\\UNC\\' + $_.Substring(2) }",
        "                    else { '\\\\?\\' + $_ }",
        "                })",
        "            }",
        "            Copy-Item -LiteralPath $copyPaths[0] -Destination $copyPaths[1] -Recurse -Force -ErrorAction Stop",
        "            $changes += $change",
        "        }",
        "        foreach ($change in $changes) {",
        "            if (Test-Path -LiteralPath $change.Target -ErrorAction Stop) {",
        "                Move-Item -LiteralPath $change.Target -Destination $change.Backup -ErrorAction Stop",
        "            }",
        "            $change.InstallStarted = $true",
        "            Move-Item -LiteralPath $change.Staged -Destination $change.Target -ErrorAction Stop",
        "        }",
        "    } catch {",
        "        $failure = $_",
        "        $rollbackErrors = @()",
        "        for ($i = $changes.Count - 1; $i -ge 0; $i--) {",
        "            $change = $changes[$i]",
        "            try {",
        "                if ($change.InstallStarted -and (Test-Path -LiteralPath $change.Target -ErrorAction Stop)) {",
        "                    Remove-Item -LiteralPath $change.Target -Recurse -Force -ErrorAction Stop",
        "                }",
        "                if (Test-Path -LiteralPath $change.Backup -ErrorAction Stop) {",
        "                    Move-Item -LiteralPath $change.Backup -Destination $change.Target -ErrorAction Stop",
        "                }",
        "            } catch {",
        "                $rollbackErrors += $_.Exception.Message",
        "            }",
        "        }",
        "        if ($rollbackErrors.Count) {",
        "            $keepBackup = $true",
        "            throw \"HBuilderX plugin refresh failed: $($failure.Exception.Message). Rollback failed: $($rollbackErrors -join '; '). Backups retained in '$transaction'.\"",
        "        }",
        "        throw $failure",
        "    } finally {",
        "        if (!$keepBackup -and (Test-Path -LiteralPath $transaction -ErrorAction Stop)) {",
        "            try {",
        "                Remove-Item -LiteralPath $transaction -Recurse -Force -ErrorAction Stop",
        "            } catch {",
        "                Write-Warning \"Could not clean up HBuilderX plugin staging directory '$transaction': $($_.Exception.Message)\"",
        "            }",
        "        }",
        "    }",
        "}"
    ],
    "bin": [
        [
            "HBuilderX.exe",
            "hbuilderx"
        ],
        [
            "cli.exe",
            "hbuilderx-cli"
        ]
    ],
    "shortcuts": [
        [
            "HBuilderX.exe",
            "HBuilderX"
        ]
    ],
    "persist": "plugins",
    "checkver": {
        "url": "https://download1.dcloud.net.cn/hbuilderx/release.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download1.dcloud.net.cn/download/HBuilderX.$version.zip"
            }
        }
    }
}
